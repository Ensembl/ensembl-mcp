{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ensembl/ensembl-genome-browser": ["node_modules/@ensembl/ensembl-genome-browser/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
